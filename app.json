{
  "expo": {
    "name": "WodkaO",
    "slug": "wodkao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wodkao",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#B47A35"
    },
    "ios": {
      "bundleIdentifier": "com.wodkao.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.wodkao.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B47A35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "backgroundColor": "#B47A35",
      "favicon": "./assets/web-icon.png",
      "meta": {
        "robots": "noindex, nofollow"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#B47A35",
          "dark": {
            "backgroundColor": "#B47A35"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1742df9-f6ff-4f18-b048-2bf2bbe853de"
      }
    },
    "owner": "maxbytes-team"
  }
}
