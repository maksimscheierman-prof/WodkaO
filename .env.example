# Copy to .env and fill with your values.
# EXPO_PUBLIC_* variables are embedded in the client bundle — use only public-safe keys.

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_MEASUREMENT_ID=your_measurement_id

# Google Sheets (card data)
EXPO_PUBLIC_GOOGLE_SHEET_ID=your_sheet_id
EXPO_PUBLIC_GOOGLE_GID_MONSTER=your_monster_gid
EXPO_PUBLIC_GOOGLE_GID_TRAPS=your_traps_gid
EXPO_PUBLIC_GOOGLE_GID_MAGIC=your_magic_gid

# Private Web test gate (MVP — not real auth; code is visible in client bundle)
EXPO_PUBLIC_TEST_ACCESS_CODE=your_test_code
# Platforms: web (default) | all | none — APK stays open when web
# EXPO_PUBLIC_TEST_ACCESS_PLATFORMS=web

# Layout debug (console logs for GameBoard geometry)
# EXPO_PUBLIC_LAYOUT_DEBUG=1

# Card modal debug overlay on game screen (works in preview APK)
# EXPO_PUBLIC_CARD_MODAL_DEBUG=1

# Force lightweight Android modal renderer (isolation test)
# EXPO_PUBLIC_CARD_MODAL_SAFE_ANDROID=1

# Optional AI commentator (requires useAiCommentator in app settings)
# Generic endpoint: POST JSON payload, respond with { "comment": "..." } or { "text": "..." }
# EXPO_PUBLIC_COMMENTATOR_AI_URL=https://your-proxy.example/commentator
# OpenAI-compatible: set URL to https://api.openai.com/v1/chat/completions + API key
# EXPO_PUBLIC_COMMENTATOR_AI_API_KEY=your_api_key

# OpenAI TTS for commentator voice (default profile: openai_onyx)
# Reuses EXPO_PUBLIC_COMMENTATOR_AI_API_KEY if set; optional alias:
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key

# ElevenLabs voice (optional — embedded in client bundle; use proxy for production)
# EXPO_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Per voice profile (ElevenLabs voice IDs):
# EXPO_PUBLIC_ELEVENLABS_VOICE_KNEIPENMEISTER=your_voice_id
# EXPO_PUBLIC_ELEVENLABS_VOICE_ANIME=your_voice_id
# EXPO_PUBLIC_ELEVENLABS_VOICE_SPORT=your_voice_id
# EXPO_PUBLIC_ELEVENLABS_VOICE_DUNGEON_MASTER=your_voice_id
# Legacy fallback for Kneipenmeister only:
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id
