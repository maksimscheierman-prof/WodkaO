rules_version = '2';

// Example only — deploy via Firebase Console or `firebase deploy --only firestore:rules`.
// MVP: permissive read/write; tighten before production.

service cloud.firestore {
  match /databases/{database}/documents {

    match /lobbies/{lobbyId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['status', 'players'])
        && request.resource.data.status == 'waiting';

      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['expiredAt'])
        || request.resource.data.status == 'expired';

      // Hard delete: Admin SDK / Cloud Function only
      allow delete: if false;
    }

    match /tests/{docId} {
      allow read, write: if true;
    }
  }
}
